# agent-cockpit environment — placeholders only, never real values.
# Set these in your hosting environment (Vercel → Settings → Environment Variables).

# --- reading (api/state.js, api/file.js) --------------------------------------------------

# The key that unlocks this dashboard. Required: without it the read endpoints answer 503
# and serve nothing, because they front a private repo. Make it long and random
# (e.g. `openssl rand -hex 20`) - never copy an example value.
# Do not rely on your host's access control alone: Vercel's "Standard Protection" exempts
# your production domain, which is the URL you actually bookmark.
VIEW_KEY=
# Only when the team repo is genuinely public and you want an open dashboard. Must be the
# exact string "true"; anything else keeps it closed.
# PUBLIC_DASHBOARD=true

# Which team repo the dashboard reads.
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-team-repo
# Only if your branch is not main.
# GITHUB_BRANCH=main
# Only if the team repo is private. Fine-grained token, Contents → Read-only, nothing else.
# GITHUB_TOKEN=your-read-only-token-here

# --- dispatching (api/fire.js) -------------------------------------------------------------

# The shared secret the fire endpoint requires in the x-fire-key header. Make it long and
# random (e.g. `openssl rand -hex 32`) — never copy an example value. If neither FIRE_KEY
# nor PUBLIC_FIRE is set, /api/fire answers 503 — closed, never open.
FIRE_KEY=

# Workflow slug → per-routine trigger URL, as one JSON object. Trigger URLs are
# secret-adjacent (anyone holding one can start a session): env var only, never the repo.
FIRE_TRIGGERS={"monday-brief":"https://example.com/your-trigger-url","lead-sweep":"https://example.com/another-trigger-url"}

# Optional: skip the fire key. Same-origin browser calls only (Sec-Fetch-Site/Origin are
# checked), but that is best-effort — non-browser clients can forge headers, so use this
# ONLY on deployments already locked behind Vercel's own access control. Anything but the
# exact string "true" still requires the key.
# PUBLIC_FIRE=true
