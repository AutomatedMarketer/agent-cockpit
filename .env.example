# Set these in your hosting provider's environment settings, not in a file you commit.

# Your GitHub username or organisation.
GITHUB_OWNER=

# The name of your team repo (shaped like agent-team-template).
GITHUB_REPO=

# The branch to read. Leave blank for main.
GITHUB_BRANCH=

# Only needed if your team repo is private.
# A fine-grained token with read-only Contents access to that one repo is enough.
# It stays on the server and is never sent to the browser.
GITHUB_TOKEN=

# Coming in build step 4 (api/fire.js): per-routine fire tokens, server-side only.
# They will be added here when that endpoint lands — nothing to set yet.
