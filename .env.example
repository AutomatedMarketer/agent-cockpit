# agent-cockpit environment — placeholders only, never real values.
# Set these in your hosting environment (Vercel → Settings → Environment Variables).

# --- signing in (api/login.js, api/logout.js) - see "Signing in" in the README -------------

# The spare key. Required: without it every endpoint answers 503 and serves nothing, because the
# board fronts a private repo. It signs in on the sign-in screen ("Use the spare key instead"), and
# scripts send it in the x-view-key header. Make it long and random - `openssl rand -hex 20`, or
#   node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
# - never copy an example value. Mark it Sensitive. Changing it signs every device out.
VIEW_KEY=
# The username and password you sign in with. The username is checked only when it is set, and
# capitals and spaces in it do not matter. The password must be 12 characters or more (shorter is
# never used); mark it Sensitive. Changing the password signs every device out.
BOARD_USERNAME=
BOARD_PASSWORD=
# Also, in Vercel (no variable): Deployment Protection -> Vercel Authentication -> All Deployments,
# which is free on every plan and keeps strangers off the board entirely, and one Firewall rule:
# Request Path equals /api/login -> Rate Limit, 10 requests per 60 seconds, by IP -> Publish.

# --- reading (api/state.js, api/file.js) --------------------------------------------------

# Only when the team repo is genuinely public and you want an open dashboard. Must be the
# exact string "true"; anything else keeps it closed.
# PUBLIC_DASHBOARD=true

# Which team repo the dashboard reads.
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-team-repo
# Only if your branch is not main.
# GITHUB_BRANCH=main
# Only if the team repo is private. Fine-grained token, Contents → Read-only, nothing else.
# GITHUB_TOKEN=your-read-only-token-here

# --- dispatching (api/fire.js) -------------------------------------------------------------

# The shared secret the fire endpoint requires in the x-fire-key header. Make it long and
# random (e.g. `openssl rand -hex 32`) — never copy an example value. If neither FIRE_KEY
# nor PUBLIC_FIRE is set, /api/fire answers 503 — closed, never open.
FIRE_KEY=

# Workflow slug → per-routine trigger URL, as one JSON object. Trigger URLs are
# secret-adjacent (anyone holding one can start a session): env var only, never the repo.
FIRE_TRIGGERS={"monday-brief":"https://example.com/your-trigger-url","lead-sweep":"https://example.com/another-trigger-url"}

# Optional: skip the fire key. Fire still needs someone signed in (or the view key) first; this
# only drops the second key. Same-origin browser calls only (Sec-Fetch-Site/Origin are checked),
# but that is best-effort - non-browser clients can forge headers. Ignored on a board with
# PUBLIC_DASHBOARD=true. Anything but the exact string "true" still requires the key.
# PUBLIC_FIRE=true

# --- personalising (api/brand.js, api/upload.js, api/art.js, api/generate.js) -------------------

# Nothing to type for the picture store itself: create a PRIVATE Blob store in Vercel, connect it
# to this project and redeploy, and Vercel sets BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN for you.
# Without a store, personalising is off and the board looks exactly as before.

# Optional: pictures from words ("Make it"). The same OpenAI key the voice assistant uses. Each
# picture is charged to that OpenAI account.
# OPENAI_API_KEY=
# Optional: the image model. Unset means gpt-image-1-mini.
# OPENAI_IMAGE_MODEL=

# Optional: a second key for CHANGING names and pictures, sent in the x-edit-key header, so you can
# share a board people may look at but not change. REQUIRED when PUBLIC_DASHBOARD=true - without it
# changes are off on an open board. Make it long and random (e.g. `openssl rand -hex 20`).
# EDIT_KEY=

# Optional: how many changes (names, uploads, resets) and how many pictures from words a day.
# Defaults 20 and 10. The counts start again at midnight UTC. 0 switches that kind of change off.
# They can be lowered freely but only raised a little: the board holds
#   2 x WRITE_DAILY_CAP + GENERATE_DAILY_CAP <= 55
# so the picture store stays under Vercel Blob's free 2,000 writes a month (going over locks the
# store for 30 days). Asked for more, it uses less: changes up to 27, pictures get what is left.
# WRITE_DAILY_CAP=
# GENERATE_DAILY_CAP=

# Recommended: how often the Blob library retries a failed write (its default is 10). A retry can
# count against the same 2,000 a month, so keep it small.
# VERCEL_BLOB_RETRIES=2
