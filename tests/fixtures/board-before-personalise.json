  "team": "<section class=\"banner team-banner\">\n    <img src=\"/art/team-workshop.webp\" alt=\"\" width=\"1600\" height=\"686\" loading=\"lazy\" decoding=\"async\" />\n    <div class=\"banner-text\">\n      <div class=\"banner-words\">\n        <p class=\"eyebrow\">Your team</p>\n        <h2 class=\"headline\">Four agents. <span class=\"soft\">One desk each.</span></h2>\n        <p class=\"banner-strap\">2 working &middot; 1 gone quiet &middot; 1 switched off</p>\n      </div>\n    </div>\n  </section><div class=\"panel add-panel\"><div class=\"add-task\">\n    <button class=\"fire\" type=\"button\" id=\"agent-open\">+ Add agent</button>\n    <form id=\"agent-form\" class=\"fire-form\" hidden>\n      <label for=\"agent-text\">What should this specialist look after?</label>\n      <textarea id=\"agent-text\" rows=\"3\" maxlength=\"2200\"\n        placeholder=\"e.g. Watches the sites I care about and tells me what changed\"></textarea>\n      <span class=\"small muted\">Your team writes the file and commits it &mdash; about a minute.\n        Nobody is there to ask you questions, so it works the rest out from your sentence and\n        leaves a card in <b>To do</b> listing what it guessed, for you to check. Nothing is\n        switched on.</span>\n      <button class=\"fire\" type=\"submit\" id=\"agent-send\">Ask for it</button>\n      <span class=\"fire-note\" id=\"agent-note\"></span>\n    </form>\n  </div></div><div class=\"team-grid\"><details class=\"agent-card agent-accent working\" style=\"border-left-color:#fb7185\">\n      <summary>\n        <div class=\"portrait\" style=\"--agent:#fb7185\">\n      <span class=\"portrait-tile\" aria-hidden=\"true\">R</span><img class=\"portrait-img\" src=\"/art/agent-research.webp\" alt=\"\" width=\"480\" height=\"480\" loading=\"lazy\" decoding=\"async\" />\n      <span class=\"status-pill\"><span class=\"dot\"></span><span class=\"state\">Working</span></span>\n    </div>\n        <div class=\"agent-body\">\n        <div