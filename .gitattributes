* text=auto eol=lf
# Pictures and the font are bytes, not lines. Without these, eol=lf above is free to decide one
# of them looks like text and rewrite it on commit - and a rewritten picture is a broken one.
*.webp binary
*.woff2 binary
# The graph libraries are pinned by their hash (tests/vendor.test.mjs): kept as bytes, never rewritten
# or diffed line by line.
public/vendor/*.js -text -diff
# The start files: cmd.exe misreads a .bat with LF endings; a .command with CRLF breaks its first line.
*.bat text eol=crlf
*.command text eol=lf
